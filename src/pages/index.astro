---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroBanner from '../components/HeroBanner.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContentCard from '../components/ContentCard.astro';
import CTAButton from '../components/CTAButton.astro';
import { getHomeContent, publicUrl } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';

const home = getHomeContent();
const { meta, hero, leistungen } = home;

const title = meta.title;
const description = meta.description;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  theme="cream"
  ogImage={publicUrl(hero.image.src)}
>
  <SiteHeader slot="header" activePath="/" variant="transparent" />

  <HeroBanner
    headline={hero.headline}
    eyebrow={hero.eyebrow}
    imageSrc={publicUrl(hero.image.src)}
    imageAlt={hero.image.alt}
    badge={hero.badge}
    primaryCta={{ label: hero.primaryCta.label, href: hero.primaryCta.href }}
    secondaryCta={{ label: hero.secondaryCta.label, href: hero.secondaryCta.href }}
  />

  <section class="section section--cream" id="leistungen">
    <div class="container home-grid">
      {
        leistungen.cards.map((card) => (
          <ContentCard
            eyebrow={card.eyebrow}
            title={card.title}
            bodyHtml={renderMarkdown(card.body)}
            href={card.cta.href}
            mediaSrc={card.image ? publicUrl(card.image.src) : undefined}
            mediaAlt={card.image?.alt}
          />
        ))
      }
    </div>
  </section>

  <HeroCarousel
    slides={[
      {
        imageSrc: publicUrl('/uploads/hero-office-2.jpg'),
        imageAlt: 'Team in einer Besprechung im hellen Büro',
        eyebrow: 'Insight',
        headline: 'Konstanz durch Kultur: Experten, die bleiben.',
      },
      {
        imageSrc: publicUrl('/uploads/hero-office-3.jpg'),
        imageAlt: 'Kolleginnen und Kollegen bei der Zusammenarbeit am Laptop',
        eyebrow: 'Kompetenzen',
        headline: 'Inspiration schafft Ideen, Unternehmenskultur treibt Innovation.',
      },
      {
        imageSrc: publicUrl('/uploads/hero-office-1.jpg'),
        imageAlt: 'Professionals mit Tablet in modernem Office',
        eyebrow: 'HR + AI',
        headline: 'Digitale Unternehmenskultur durch Kompetenzmanagement.',
      },
    ]}
  />

  <section class="section section--blue">
    <div class="container cta-band">
      <SectionHeading text="Bereit für den nächsten Schritt?" level={2} />
      <p>Sprechen Sie mit uns über Projektunterstützung, Produkte und digitale Kultur.</p>
      <CTAButton label="jetzt vernetzen" href="/kontakt" variant="ghost-light" />
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    gap: var(--space-5);
  }

  .cta-band {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .cta-band p {
    margin: 0;
    max-width: 40rem;
    font-size: var(--font-size-lg);
  }

  @media (min-width: 900px) {
    .home-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
