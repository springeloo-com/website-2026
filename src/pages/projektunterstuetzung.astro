---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CTAButton from '../components/CTAButton.astro';
import { getProjektunterstuetzungContent, publicUrl } from '../lib/content';
import HeroShine from '../components/HeroShine.astro';

const page = getProjektunterstuetzungContent();
const { meta, hero, intro, kompetenzen, frameworks, solutions, branchen, cta } = page;

const lines = (text: string) => text.split('\n').filter((line) => line.length > 0);
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/projektunterstuetzung" ogImage={publicUrl(hero.image.src)}>
  <SiteHeader slot="header" activePath="/projektunterstuetzung" variant="transparent" />

  <section class="pu-hero" aria-label="Hero">
    <img class="pu-hero__image" src={publicUrl(hero.image.src)} alt={hero.image.alt} />
    <div class="pu-hero__shade" aria-hidden="true"></div>
    <HeroShine />
    <div class="grid-overlay" aria-hidden="true"></div>
    <div class="container pu-hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.headline}</h1>
    </div>
  </section>

  <section class="pu-intro section section--cream" id="insight">
    <div class="container">
      <p class="pu-intro__lead">{intro.lead}</p>
      <p class="pu-intro__body">{intro.body}</p>
    </div>
  </section>

  <section class="pu-kompetenzen" id="kompetenzen" data-pu-tabs>
    <div class="container">
      <p class="pu-kicker pu-kicker--light">{kompetenzen.kicker}</p>
      <h2>{kompetenzen.headline}</h2>

      <div class="pu-tabs">
        <div class="pu-tabs__nav" role="tablist" aria-label="Kompetenzbereiche">
          {
            kompetenzen.tabs.map((item, index) => (
              <button
                type="button"
                class:list={['pu-tabs__btn', { 'is-active': index === 0 }]}
                role="tab"
                id={`tab-${item.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`panel-${item.id}`}
                data-pu-tab={item.id}
              >
                {item.label}
              </button>
            ))
          }
        </div>

        <div class="pu-tabs__panels">
          {
            kompetenzen.tabs.map((item, index) => (
              <div
                class:list={['pu-tabs__panel', { 'is-active': index === 0 }]}
                role="tabpanel"
                id={`panel-${item.id}`}
                aria-labelledby={`tab-${item.id}`}
                hidden={index !== 0}
                data-pu-panel={item.id}
              >
                <div class="pu-tabs__copy">
                  <h3>{item.label}</h3>
                  <p class="pu-tabs__strong">{item.bodyStrong}</p>
                  <p>{item.body}</p>
                </div>
                <div class="pu-tabs__media">
                  <img
                    src={publicUrl(kompetenzen.image.src)}
                    alt={kompetenzen.image.alt}
                    width="800"
                    height="600"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="pu-frameworks section section--cream">
    <div class="container">
      <p class="pu-kicker">{frameworks.kicker}</p>
      <h2>{frameworks.headline}</h2>
      <div class="pu-frameworks__split">
        <p>{frameworks.body}</p>
        <div>
          <p class="pu-kicker">{frameworks.kernbereicheKicker}</p>
          <p class="pu-frameworks__kern">
            {
              frameworks.kernbereiche.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))
            }
          </p>
        </div>
      </div>

      <ul class="pu-pillars">
        {
          frameworks.pillars.map((pillar) => (
            <li>
              <div class="pu-pillars__head">
                <span class="pu-pillars__mark" aria-hidden="true">
                  <img src={publicUrl(pillar.icon)} alt="" width="40" height="40" />
                </span>
                <h3>{pillar.title}</h3>
              </div>
              <p>{pillar.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="pu-frameworks__end">{frameworks.closing}</p>
    </div>
  </section>

  <section class="pu-solutions section section--cream">
    <div class="container">
      <p class="pu-kicker">{solutions.kicker}</p>
      <h2>{solutions.headline}</h2>
      <div class="pu-solutions__grid">
        <p>{solutions.columnA}</p>
        <p>{solutions.columnB}</p>
      </div>
      <p class="pu-solutions__merkmal">
        <strong>{solutions.merkmalLabel}</strong> {solutions.merkmalBody}
      </p>
    </div>
  </section>

  <section class="pu-branchen">
    <div class="container">
      <p class="pu-kicker pu-kicker--light">{branchen.kicker}</p>
      <h2>{branchen.headline}</h2>
      <p class="pu-branchen__lead">{branchen.lead}</p>
      <div class="pu-branchen__grid">
        {
          branchen.groups.map((group) => (
            <div>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pu-cta page-cta-band">
    <div class="grid-overlay grid-overlay--cta" aria-hidden="true"></div>
    <div class="container pu-cta__inner">
      <div class="pu-cta__copy">
        <p class="pu-cta__kicker">{cta.kicker}</p>
        <h2>
          {
            lines(cta.headline).map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </h2>
        <CTAButton label={cta.label} href={cta.href} variant="ghost-light" />
      </div>
      <p class="pu-cta__aside">
        {
          lines(cta.aside).map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  const root = document.querySelector('[data-pu-tabs]');
  if (root) {
    const buttons = root.querySelectorAll('[data-pu-tab]');
    const panels = root.querySelectorAll('[data-pu-panel]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-pu-tab');
        buttons.forEach((btn) => {
          const active = btn === button;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute('data-pu-panel') === id;
          panel.classList.toggle('is-active', active);
          panel.toggleAttribute('hidden', !active);
        });
      });
    });
  }
</script>

<style>
  .pu-hero {
    position: relative;
    min-height: 85vh;
    color: var(--color-white);
  }

  .pu-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pu-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 47%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 38%);
    z-index: 1;
  }

  .pu-hero__content {
    position: relative;
    z-index: 2;
    min-height: 85vh;
    display: grid;
    align-content: end;
    gap: var(--space-4);
    padding-block: calc(var(--header-height) + var(--space-6)) var(--space-7);
  }

  .pu-hero h1 {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    line-height: var(--line-tight);
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-semibold);
  }

  .pu-kicker {
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .pu-kicker--light {
    color: var(--color-cream);
  }

  .pu-intro__lead {
    margin: 0 0 var(--space-5);
    color: var(--color-blue);
    font-size: clamp(1.5rem, 3vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 40rem;
  }

  .pu-intro__body {
    margin: 0;
    max-width: 42rem;
    margin-left: clamp(1.5rem, 12vw, 8rem);
    font-size: var(--font-size-lg);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .pu-kompetenzen {
    background: var(--color-blue);
    color: var(--color-cream);
    padding-block: var(--space-8);
  }

  .pu-kompetenzen h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.15;
    max-width: 22ch;
  }

  .pu-tabs__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .pu-tabs__btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    font: inherit;
    font-size: clamp(1.15rem, 2vw, 1.75rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    padding: 0.35rem 0;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition: opacity var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }

  .pu-tabs__btn:hover {
    opacity: 0.75;
  }

  .pu-tabs__btn.is-active {
    border-bottom-color: var(--color-cream);
    opacity: 1;
  }

  .pu-tabs__panel {
    display: none;
    gap: var(--space-5);
  }

  .pu-tabs__panel.is-active {
    display: grid;
  }

  .pu-tabs__copy h3 {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.15;
  }

  .pu-tabs__strong {
    margin: 0 0 var(--space-4);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-lg);
    line-height: 1.45;
  }

  .pu-tabs__copy p {
    margin: 0;
    line-height: 1.5;
    font-size: var(--font-size-lg);
  }

  .pu-tabs__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, var(--color-cream) 12%, transparent);
  }

  .pu-tabs__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pu-frameworks h2,
  .pu-solutions h2,
  .pu-branchen h2 {
    margin: 0 0 var(--space-5);
    color: var(--color-blue);
    font-size: clamp(1.75rem, 3.2vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.15;
    max-width: 22ch;
  }

  .pu-frameworks__split {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .pu-frameworks__split p,
  .pu-frameworks__end,
  .pu-solutions p,
  .pu-branchen__lead {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: 1.5;
  }

  .pu-frameworks__kern {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    color: var(--color-ink);
  }

  .pu-pillars {
    list-style: none;
    margin: 0 0 var(--space-7);
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .pu-pillars h3 {
    margin: 0;
    font-size: var(--font-size-xl);
  }

  .pu-pillars p {
    margin: var(--space-3) 0 0;
    line-height: 1.5;
  }

  .pu-pillars__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .pu-pillars__mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-cream) 82%, var(--color-ink));
  }

  .pu-pillars__mark img {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
  }

  .pu-solutions__grid {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .pu-solutions__merkmal {
    padding-top: var(--space-5);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .pu-branchen {
    background: var(--color-blue);
    color: var(--color-cream);
    padding-block: var(--space-8);
  }

  .pu-branchen h2 {
    color: var(--color-cream);
  }

  .pu-branchen__lead {
    margin-bottom: var(--space-7);
    max-width: 40rem;
  }

  .pu-branchen__grid {
    display: grid;
    gap: var(--space-6);
  }

  .pu-branchen h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-xl);
  }

  .pu-branchen ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .pu-branchen li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--font-size-lg);
  }

  .pu-branchen li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 5px;
    background: var(--color-cream);
  }

  .pu-cta {
    color: var(--color-cream);
    padding-block: var(--space-8);
  }

  .pu-cta__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .pu-cta__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .pu-cta__kicker,
  .pu-cta__aside {
    margin: 0;
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .pu-cta h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.12;
  }

  .pu-cta__aside {
    max-width: 14ch;
  }

  @media (min-width: 768px) {
    .pu-tabs__panel.is-active {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .pu-pillars {
      grid-template-columns: 1fr 1fr;
    }

    .pu-cta__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
      justify-items: stretch;
    }

    .pu-cta__aside {
      text-align: right;
      justify-self: end;
    }
  }

  @media (min-width: 1024px) {
    .pu-tabs {
      display: grid;
      grid-template-columns: minmax(14rem, 18rem) 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    .pu-tabs__nav {
      margin-bottom: 0;
    }

    .pu-frameworks__split,
    .pu-solutions__grid {
      grid-template-columns: 1.4fr 1fr;
    }

    .pu-branchen__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
