---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CTAButton from '../components/CTAButton.astro';
import ProductHeaderSlider from '../components/ProductHeaderSlider.astro';
import { getProdukteContent, publicUrl } from '../lib/content';

const page = getProdukteContent();
const { meta, intro, lead, slider, products, oss, cta } = page;

const sliderSlides = slider.slides.map((slide) => ({
  id: slide.id,
  name: slide.name,
  description: slide.description,
  image: slide.image.src,
  alt: slide.image.alt,
}));
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/produkte" theme="dark" ogImage={publicUrl(intro.image.src)}>
  <SiteHeader slot="header" activePath="/produkte" variant="transparent" />

  <div class="produkte">
    {/* Figma Header-slider-01 — product karusell + next/prev arrows */}
    <ProductHeaderSlider slides={sliderSlides} startIndex={slider.startIndex} />

    <section class="produkte-hero" aria-label="Produkte Intro" id="intro">
      <div class="container produkte-hero__grid">
        <div class="produkte-hero__copy">
          <h1>{intro.headline}</h1>
        </div>
        <div class="produkte-hero__media">
          <img src={publicUrl(intro.image.src)} alt={intro.image.alt} width="1024" height="680" />
        </div>
      </div>
    </section>

    <section class="produkte-lead" id="uebersicht">
      <div class="container">
        <p class="produkte-kicker">{lead.kicker}</p>
        <h2>{lead.headline}</h2>
        <p class="produkte-lead__body">{lead.body}</p>
      </div>
    </section>

    {
      products.map((product) => (
        <section class="product-block" id={product.id} aria-labelledby={`${product.id}-title`}>
          <div class="product-block__start">
            <div class="container product-block__head">
              <div>
                <p class="produkte-kicker">{product.category}</p>
                <h2 id={`${product.id}-title`}>{product.name}</h2>
              </div>
              {product.logo ? (
                <img class="product-block__logo" src={publicUrl(product.logo.src)} alt={product.logo.alt} width="144" height="61" />
              ) : null}
            </div>
            <div class="product-block__mock container">
              <img src={publicUrl(product.mock.src)} alt={product.mock.alt} width="1314" height="572" />
            </div>
          </div>

          <div class="product-block__features">
            <div class="container product-block__features-grid">
              {product.features.map((feature) => (
                <article>
                  <span class="product-block__icon" aria-hidden="true" />
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="product-block__summary">
            <div class="container">
              <p class="produkte-kicker">{product.name}</p>
              <p>{product.summary}</p>
            </div>
          </div>

          <div class="product-block__details">
            <div class="container">
              {product.details.map((item, index) => (
                <details class="product-detail" open={index === 0}>
                  <summary>{item.title}</summary>
                  <p>{item.body}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <section class="produkte-oss" aria-label="Open Source">
      <div class="container">
        <p class="produkte-kicker">{oss.kicker}</p>
        <h2>{oss.headline}</h2>
        <p>{oss.body}</p>
      </div>
    </section>

    <section class="produkte-cta">
      <div class="container produkte-cta__inner">
        <h2>{cta.headline}</h2>
        <CTAButton label={cta.label} href={cta.href} variant="ghost-light" />
      </div>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .produkte {
    position: relative;
    color: var(--color-cream);
    background: #1d2228;
  }

  .produkte-kicker {
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .produkte-hero {
    padding-block: var(--space-7);
    background: #1d2228;
  }

  .produkte-hero__grid {
    display: grid;
    gap: var(--space-6);
  }

  .produkte-hero__media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #111;
  }

  .produkte-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .produkte-hero h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .produkte-lead__body,
  .product-block__summary p,
  .produkte-oss p {
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    max-width: 48rem;
  }

  .produkte-lead {
    padding-block: var(--space-8);
    background: var(--color-ink);
  }

  .produkte-lead h2 {
    margin: 0 0 var(--space-5);
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    max-width: 40rem;
  }

  .product-block__start {
    background: #1d2228;
    padding-block: var(--space-7) var(--space-5);
  }

  .product-block__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .product-block__head h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-regular);
    text-transform: lowercase;
    letter-spacing: -0.02em;
  }

  .product-block__logo {
    width: 7rem;
    height: auto;
    opacity: 0.95;
  }

  .product-block__mock {
    overflow: hidden;
  }

  .product-block__mock img {
    width: 100%;
    height: auto;
    display: block;
  }

  .product-block__features,
  .product-block__summary,
  .product-block__details {
    background: var(--color-ink);
    padding-block: var(--space-7);
  }

  .product-block__features-grid {
    display: grid;
    gap: var(--space-6);
  }

  .product-block__features article h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .product-block__features article p {
    margin: 0;
    line-height: 1.5;
    opacity: 0.95;
  }

  .product-block__icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-4);
    border: 1.5px solid color-mix(in srgb, var(--color-cream) 55%, transparent);
    border-radius: 0.35rem;
  }

  .product-detail {
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 25%, transparent);
    padding-block: var(--space-4);
  }

  .product-detail:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-cream) 25%, transparent);
  }

  .product-detail summary {
    cursor: pointer;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    list-style: none;
  }

  .product-detail summary::-webkit-details-marker {
    display: none;
  }

  .product-detail p {
    margin: var(--space-3) 0 0;
    max-width: 48rem;
    line-height: 1.5;
    opacity: 0.92;
  }

  .produkte-oss {
    padding-block: var(--space-8);
    background: #1d2228;
  }

  .produkte-oss h2 {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: var(--font-weight-regular);
  }

  .produkte-cta {
    padding-block: var(--space-8);
    background: var(--color-ink);
  }

  .produkte-cta__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .produkte-cta h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.15;
    white-space: pre-line;
  }

  :global(.theme-dark) :global(.site-header--transparent) {
    background: transparent;
    color: var(--color-cream);
  }

  @media (min-width: 768px) {
    .produkte-hero__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .product-block__features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
