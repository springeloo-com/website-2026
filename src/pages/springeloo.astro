---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CTAButton from '../components/CTAButton.astro';
import HeroShine from '../components/HeroShine.astro';
import { getSiteMeta, getSpringelooContent, publicUrl } from '../lib/content';

const siteMeta = getSiteMeta();
const page = getSpringelooContent();
const { meta, hero, intro, numbers, insights, management, cta } = page;

const lines = (text: string) => text.split('\n').filter((line) => line.length > 0);
---

<BaseLayout title={meta.title} description={meta.description} canonicalPath="/springeloo" ogImage={publicUrl(hero.image.src)}>
  <SiteHeader slot="header" activePath="/springeloo" variant="transparent" />

  <section class="sp-hero" aria-label="Hero">
    <img class="sp-hero__image" src={publicUrl(hero.image.src)} alt={hero.image.alt} width="1920" height="1080" />
    <div class="sp-hero__shade" aria-hidden="true"></div>
    <HeroShine />
    <div class="grid-overlay" aria-hidden="true"></div>
    <div class="container sp-hero__content">
      <div class="sp-hero__meta">
        <p>
          {
            lines(hero.eyebrow).map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </p>
        <p>
          {
            lines(hero.brand).map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </p>
      </div>
      <h1>
        {
          lines(hero.headline).map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </h1>
    </div>
  </section>

  <section class="sp-intro section section--cream">
    <div class="container">
      <p class="sp-intro__lead">{intro.lead}</p>
      <div class="sp-intro__body">
        <p>{intro.columnA}</p>
        <p>{intro.columnB}</p>
      </div>
    </div>
  </section>

  <section class="sp-numbers section section--cream">
    <div class="container">
      <div class="sp-numbers__intro">
        <p class="sp-numbers__strong">{numbers.strong}</p>
        <p>{numbers.body}</p>
      </div>
      <hr class="sp-divider" />
      <ul class="sp-stats">
        {
          numbers.stats.map((stat) => (
            <li>
              <p class="sp-stats__value">{stat.value}</p>
              <p class="sp-stats__label">{stat.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sp-insights" id="insights" data-sp-tabs>
    <div class="container">
      <p class="sp-kicker sp-kicker--light">{insights.kicker}</p>
      <h2>{insights.headline}</h2>

      <div class="sp-tabs">
        <div class="sp-tabs__nav" role="tablist" aria-label="Springeloo Insights">
          {
            insights.tabs.map((item, index) => (
              <button
                type="button"
                class:list={['sp-tabs__btn', { 'is-active': index === 0 }]}
                role="tab"
                id={`sp-tab-${item.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`sp-panel-${item.id}`}
                data-sp-tab={item.id}
              >
                {item.label}
              </button>
            ))
          }
        </div>

        <div class="sp-tabs__panels">
          {
            insights.tabs.map((item, index) => (
              <div
                class:list={['sp-tabs__panel', { 'is-active': index === 0 }]}
                role="tabpanel"
                id={`sp-panel-${item.id}`}
                aria-labelledby={`sp-tab-${item.id}`}
                hidden={index !== 0}
                data-sp-panel={item.id}
              >
                <div class="sp-tabs__copy">
                  <h3>{item.title}</h3>
                  <p class="sp-tabs__lead">{item.lead}</p>
                  <p>{item.body}</p>
                </div>
                <div class="sp-tabs__media">
                  <img
                    src={publicUrl(insights.image.src)}
                    alt={insights.image.alt}
                    width="1600"
                    height="1067"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sp-mgmt section section--cream" id="management">
    <div class="container">
      <p class="sp-kicker">{management.kicker}</p>
      <h2>
        {
          lines(management.headline).map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>

      <ul class="sp-team">
        {
          management.team.map((person) => (
            <li class="sp-person">
              <div class="sp-person__photo">
                <img src={publicUrl(person.image.src)} alt={person.image.alt} width="800" height="660" />
              </div>
              <div class="sp-person__text">
                <p class="sp-person__name">{person.name}</p>
                <p class="sp-person__role">{person.role}</p>
                <ul class="sp-person__tags">
                  {person.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
              <a class="sp-person__link" href={siteMeta.linkedIn} target="_blank" rel="noopener noreferrer">
                <img
                  class="sp-person__li"
                  src={publicUrl('/uploads/linkedin-bug.png')}
                  alt=""
                  width="36"
                  height="31"
                />
                <span>Jetzt vernetzen</span>
                <span class="sp-person__chevron" aria-hidden="true">›</span>
              </a>
            </li>
          ))
        }
      </ul>

      <hr class="sp-divider" />

      <p class="sp-mgmt__quote">{management.quote}</p>
    </div>
  </section>

  <section class="sp-cta page-cta-band">
    <div class="grid-overlay grid-overlay--cta" aria-hidden="true"></div>
    <div class="container sp-cta__inner">
      <div class="sp-cta__copy">
        <p class="sp-kicker sp-kicker--cream">{cta.kicker}</p>
        <h2>
          {
            lines(cta.headline).map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </h2>
        <CTAButton label={cta.label} href={cta.href} variant="ghost-light" />
      </div>
      <p class="sp-cta__aside">
        {
          lines(cta.aside).map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  const root = document.querySelector('[data-sp-tabs]');
  if (root) {
    const buttons = root.querySelectorAll('[data-sp-tab]');
    const panels = root.querySelectorAll('[data-sp-panel]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-sp-tab');
        buttons.forEach((btn) => {
          const active = btn === button;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute('data-sp-panel') === id;
          panel.classList.toggle('is-active', active);
          panel.toggleAttribute('hidden', !active);
        });
      });
    });
  }
</script>

<style>
  .sp-hero {
    position: relative;
    min-height: 85vh;
    color: var(--color-cream);
  }

  .sp-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sp-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 47%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 38%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1));
    z-index: 1;
  }

  .sp-hero__content {
    position: relative;
    z-index: 2;
    min-height: 85vh;
    display: grid;
    align-content: space-between;
    gap: var(--space-6);
    padding-block: calc(var(--header-height) + var(--space-6)) var(--space-7);
  }

  .sp-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) clamp(2rem, 20vw, 22rem);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
  }

  .sp-hero__meta p {
    margin: 0;
  }

  .sp-hero h1 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(1.75rem, 4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-regular);
  }

  .sp-kicker {
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue);
  }

  .sp-kicker--light {
    color: var(--color-cream);
  }

  .sp-kicker--cream {
    color: var(--color-cream);
  }

  .sp-intro__lead {
    margin: 0 0 var(--space-6);
    color: var(--color-blue);
    font-size: clamp(1.5rem, 3vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 42rem;
  }

  .sp-intro__body {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
    margin-inline-start: clamp(0px, 6vw, 7rem);
  }

  .sp-intro__body p {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: 1.5;
  }

  .sp-numbers__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
    margin-bottom: var(--space-6);
  }

  .sp-numbers__strong {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }

  .sp-numbers__intro p:last-child {
    margin: 0;
    font-size: var(--font-size-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .sp-divider {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    margin: 0 0 var(--space-7);
  }

  .sp-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-7);
  }

  .sp-stats__value {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 6.875rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .sp-stats__label {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: 1.4;
    max-width: 18ch;
  }

  .sp-insights {
    background:
      linear-gradient(160deg, #4a9fd0 0%, var(--color-blue) 42%, #2f6f9a 100%);
    color: var(--color-cream);
    padding-block: var(--space-8);
  }

  .sp-insights h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.15;
    max-width: 22ch;
  }

  .sp-tabs__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .sp-tabs__btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    font: inherit;
    font-size: clamp(1.15rem, 2vw, 1.875rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    padding: 0.35rem 0;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition: opacity var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }

  .sp-tabs__btn:hover {
    opacity: 0.75;
  }

  .sp-tabs__btn.is-active {
    border-bottom-color: var(--color-cream);
    opacity: 1;
  }

  .sp-tabs__panel {
    display: none;
    gap: var(--space-5);
  }

  .sp-tabs__panel.is-active {
    display: grid;
  }

  .sp-tabs__copy h3 {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.35rem, 2.4vw, 2.25rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
  }

  .sp-tabs__lead {
    margin: 0 0 var(--space-4);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-lg);
    line-height: 1.45;
  }

  .sp-tabs__copy p {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: 1.5;
    max-width: 42rem;
  }

  .sp-tabs__media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--color-cream) 12%, transparent);
  }

  .sp-tabs__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sp-mgmt h2 {
    margin: 0 0 var(--space-7);
    color: var(--color-blue);
    font-size: clamp(1.75rem, 3.2vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.15;
  }

  .sp-team {
    list-style: none;
    margin: 0 0 var(--space-7);
    padding: 0;
    display: grid;
    gap: var(--space-7);
  }

  .sp-person {
    display: grid;
    gap: var(--space-5);
  }

  .sp-person__photo {
    aspect-ratio: 4 / 3.3;
    overflow: hidden;
    background: var(--color-cream-soft);
  }

  .sp-person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sp-person__name {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .sp-person__role {
    margin: 0.15rem 0 0;
    font-size: var(--font-size-md);
  }

  .sp-person__tags {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sp-person__tags li {
    background: var(--color-cream-soft);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.75rem;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  .sp-person__link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: var(--space-4);
    border-block: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    text-decoration: none;
    color: inherit;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
  }

  .sp-person__link:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .sp-person__li {
    width: 2rem;
    height: auto;
    flex-shrink: 0;
  }

  .sp-person__chevron {
    margin-left: auto;
    font-size: 1.4em;
    line-height: 1;
  }

  .sp-mgmt__quote {
    margin: 0;
    color: var(--color-blue);
    font-size: clamp(1.5rem, 3vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .sp-cta {
    padding-block: var(--space-8);
  }

  .sp-cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
  }

  .sp-cta__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .sp-cta h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 4.5rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .sp-cta__aside {
    margin: 0;
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .sp-stats {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-8);
      row-gap: var(--space-8);
    }

    .sp-tabs__panel.is-active {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .sp-team {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .sp-tabs {
      display: grid;
      grid-template-columns: minmax(12rem, 16rem) 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    .sp-tabs__nav {
      margin-bottom: 0;
    }

    .sp-cta__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .sp-cta__aside {
      text-align: right;
    }
  }
</style>
