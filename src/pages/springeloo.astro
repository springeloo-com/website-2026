---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import hero from '../assets/images/hero-office-3.jpg';

const title = 'Springeloo';
const description = 'Konstanz durch Kultur: Experten, die bleiben — über springeloo.';
---

<BaseLayout title={title} description={description} canonicalPath="/springeloo" ogImage={hero.src}>
  <SiteHeader slot="header" activePath="/springeloo" variant="transparent" />

  <section class="page-hero">
    <img src={hero.src} alt="Drei springeloo Experten im Gespräch" />
    <div class="page-hero__shade" aria-hidden="true"></div>
    <div class="grid-overlay" aria-hidden="true"></div>
    <div class="container page-hero__content">
      <p class="eyebrow">future by professionals.</p>
      <p class="meta">springeloo GmbH</p>
      <h1>Konstanz durch Kultur:<br />Experten, die bleiben.</h1>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container about">
      <h2>Über springeloo</h2>
      <p>
        Wir gestalten digitale Zusammenarbeit mit Haltung: kompetent, beständig und nah an den Menschen,
        die Transformation tragen. Kultur ist unser Stabilitätsanker — Technologie unser Handwerk.
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    color: var(--color-white);
  }

  .page-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 47%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 38%);
    z-index: 1;
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-content: end;
    gap: var(--space-3);
    padding-block: calc(var(--header-height) + 2rem) var(--space-8);
  }

  .meta {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .page-hero h1 {
    margin: 0;
    max-width: 16ch;
    font-size: var(--font-size-3xl);
    line-height: var(--line-tight);
    letter-spacing: -0.02em;
    color: var(--color-cream);
    font-weight: var(--font-weight-regular);
  }

  .about {
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
  }

  .about h2 {
    margin: 0;
  }

  .about p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--font-size-lg);
  }
</style>
