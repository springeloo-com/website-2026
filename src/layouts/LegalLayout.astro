---
/**
 * Shared layout for Impressum / Datenschutz legal pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BrandTag from '../components/BrandTag.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  html: string;
}

const { title, description, canonicalPath, html } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} theme="dark">
  <SiteHeader slot="header" activePath="/kontakt" variant="transparent" />

  <section class="legal-page" aria-label={title}>
    <div class="grid-overlay grid-overlay--dark" aria-hidden="true"></div>
    <BrandTag />
    <div class="container legal-page__inner">
      <article class="legal-prose" set:html={html} />
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .legal-page {
    position: relative;
    background: var(--color-ink);
    color: var(--color-cream);
    padding-block: calc(var(--header-height) + var(--space-8)) var(--space-8);
    overflow: hidden;
    min-height: 70vh;
  }

  .legal-page::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: min(40vh, 20rem);
    background: radial-gradient(ellipse 80% 100% at 50% 100%, rgba(62, 144, 198, 0.35), transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .grid-overlay--dark {
    opacity: 0.18;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-cream) 35%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-cream) 35%, transparent) 1px, transparent 1px);
    background-size: 12.5% 16.666%;
  }

  :global(.theme-dark) :global(.site-header--transparent) {
    background: transparent;
    color: var(--color-cream);
  }

  .legal-page__inner {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .legal-prose :global(h1) {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .legal-prose :global(h2) {
    margin: var(--space-7) 0 var(--space-4);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
  }

  .legal-prose :global(h3) {
    margin: var(--space-5) 0 var(--space-3);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }

  .legal-prose :global(p),
  .legal-prose :global(li) {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-md);
    line-height: 1.6;
    opacity: 0.92;
  }

  .legal-prose :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: 1.25rem;
  }

  .legal-prose :global(a) {
    color: var(--color-blue-soft);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .legal-prose :global(a:hover) {
    color: var(--color-cream);
  }

  .legal-prose :global(strong) {
    font-weight: var(--font-weight-semibold);
    opacity: 1;
  }
</style>
