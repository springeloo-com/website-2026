---
import { getSiteMeta, publicUrl } from '../lib/content';

const siteMeta = getSiteMeta();
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const phoneDisplay = siteMeta.contactPhone || siteMeta.phone;
const phoneHref = `tel:${phoneDisplay.replace(/\s/g, '')}`;
const email = siteMeta.contactEmail || siteMeta.email;
const mapsUrl = 'https://maps.app.goo.gl/UDyRK9NH3pAXULks9';
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <p class="site-footer__tagline">{siteMeta.footerTagline}</p>
      <a class="site-footer__logo" href={`${base}/`} aria-label={siteMeta.name}>
        <img
          class="site-footer__emblem"
          src={publicUrl('/uploads/springeloo/emblem.svg')}
          alt=""
          width="40"
          height="40"
        />
        <img
          class="site-footer__wordmark"
          src={publicUrl('/uploads/springeloo/wordmark.svg')}
          alt={siteMeta.name}
          width="180"
          height="38"
        />
      </a>
    </div>

    <div class="site-footer__cols">
      <div>
        <h2 class="site-footer__label">Adresse</h2>
        <a class="site-footer__address" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <strong>{siteMeta.company}</strong><br />
          {
            siteMeta.addressLines.map((line) => (
              <>
                {line}
                <br />
              </>
            ))
          }
        </a>
      </div>

      <div>
        <h2 class="site-footer__label">Kontakt</h2>
        <p>
          <a href={phoneHref}>T. {phoneDisplay}</a><br />
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <div>
        <h2 class="site-footer__label">Socials</h2>
        <a class="site-footer__social" href={siteMeta.linkedIn} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <img src={publicUrl('/uploads/linkedin-bug.png')} alt="" width="48" height="40" />
        </a>
      </div>
    </div>
  </div>

  <div class="site-footer__band" aria-hidden="true"></div>

  <div class="container site-footer__bottom">
    <nav aria-label="Rechtliches">
      {
        siteMeta.legal.map((item) => (
          <a href={`${base}${item.href}`}>{item.label}</a>
        ))
      }
    </nav>
    <p>© {year} {siteMeta.company}. Alle Rechte vorbehalten</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-cream);
    color: var(--color-ink);
    padding-block: var(--space-6) var(--space-5);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-7);
    padding-bottom: var(--space-6);
  }

  .site-footer__tagline {
    margin: 0 0 var(--space-7);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.5;
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .site-footer__logo:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  .site-footer__emblem {
    width: 2.5rem;
    height: 2.5rem;
  }

  .site-footer__wordmark {
    width: clamp(8rem, 28vw, 11.5rem);
    height: auto;
  }

  .site-footer__cols {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__label {
    margin: 0 0 var(--space-4);
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .site-footer p,
  .site-footer__address {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.5;
    font-size: var(--font-size-md);
    text-decoration: none;
  }

  .site-footer a:not(.site-footer__logo):not(.site-footer__social) {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:not(.site-footer__logo):not(.site-footer__social):hover {
    text-decoration: underline;
  }

  .site-footer__social {
    display: inline-block;
    margin-top: auto;
    line-height: 0;
  }

  .site-footer__social img {
    width: 3rem;
    height: auto;
  }

  .site-footer__band {
    height: 2.625rem;
    background: color-mix(in srgb, var(--color-cream-dark) 20%, transparent);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-5);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-medium);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__bottom nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .site-footer__top {
      grid-template-columns: minmax(12rem, 1fr) minmax(18rem, 1.6fr);
      align-items: stretch;
    }

    .site-footer__cols {
      grid-template-columns: 1.2fr 1.2fr auto;
      gap: var(--space-5);
      align-items: stretch;
    }

    .site-footer__cols > div {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 12rem;
    }

    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }

    .site-footer__bottom nav {
      flex-direction: row;
      gap: var(--space-6);
    }
  }
</style>
