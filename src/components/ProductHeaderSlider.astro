---
/**
 * Figma Header-slider-01 + product-karusell-Desktop / Mobil
 * Desktop: I2109:78612;2077:91251 · Mobile: I2109:114326;2095:37160
 */
import { publicUrl } from '../lib/content';

export type ProductSlide = {
  id: string;
  name: string;
  description: string[];
  /** Short paragraph under the title (falls back to description lines). */
  body?: string;
  details?: Array<{ title: string; body: string }>;
  image: string;
  alt: string;
};

interface Props {
  slides: ProductSlide[];
  /** Index of the initially centered product (Figma default often Host Ablöse). */
  startIndex?: number;
}

const { slides, startIndex = 0 } = Astro.props;

const resolved = slides.map((slide) => ({
  name: slide.name,
  description: slide.description,
  body: slide.body?.trim() || slide.description.join('. '),
  details: slide.details ?? [],
  href: `#${slide.id}`,
  image: publicUrl(slide.image),
  alt: slide.alt,
}));

const wrap = (i: number) =>
  resolved[(((i % resolved.length) + resolved.length) % resolved.length)];
const initial = wrap(startIndex) ?? resolved[0];
const prev = wrap(startIndex - 1) ?? resolved[0];
const next = wrap(startIndex + 1) ?? resolved[0];
const arrowLeft = publicUrl('/uploads/effects/slide-arrow-left.svg');
const arrowRight = publicUrl('/uploads/effects/slide-arrow-right.svg');
---

<section
  class="phs"
  aria-roledescription="Karussell"
  aria-label="Produktübersicht"
  data-product-header-slider
  data-start-index={startIndex}
  data-slides={JSON.stringify(resolved)}
  tabindex="0"
>
  <div class="phs__blue-shine" aria-hidden="true">
    <div class="phs__blue-top"></div>
    <div class="phs__blue-bottom"></div>
  </div>

  <div class="phs__raster" aria-hidden="true">
    <div class="phs__raster-grid">
      {
        Array.from({ length: 5 }, (_, row) => (
          <div class="phs__raster-row">
            {Array.from({ length: 8 }, () => (
              <span class="phs__raster-cell" />
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="phs__hit" data-interaktionsflaeche aria-hidden="true"></div>

  <p class="phs__slogan">
    future by
    <br aria-hidden="true" />
    professionals.
  </p>

  <div class="phs__karusell">
    <div class="phs__wrap">
      <div class="phs__reihe" data-phs-reihe>
        <article class="phs__tile phs__tile--small" data-phs-tile="prev" aria-hidden="true">
          <div class="phs__foto">
            <img src={prev.image} alt="" width="280" height="280" decoding="async" />
            <span class="phs__veil phs__veil--small" aria-hidden="true"></span>
          </div>
        </article>

        <article class="phs__tile phs__tile--big" data-phs-tile="active">
          <div class="phs__foto">
            <img src={initial.image} alt={initial.alt} width="440" height="440" decoding="async" />
            <span class="phs__veil phs__veil--big" aria-hidden="true"></span>
          </div>
        </article>

        <article class="phs__tile phs__tile--small" data-phs-tile="next" aria-hidden="true">
          <div class="phs__foto">
            <img src={next.image} alt="" width="280" height="280" decoding="async" />
            <span class="phs__veil phs__veil--small" aria-hidden="true"></span>
          </div>
        </article>
      </div>
    </div>

    <div class="phs__arrows" data-node-id="2085:63004">
      <button type="button" class="phs__arrow" data-phs-prev aria-label="Vorheriges Produkt">
        <span class="phs__arrow-icon" aria-hidden="true">
          <img src={arrowLeft} alt="" width="6" height="10" />
        </span>
      </button>
      <button type="button" class="phs__arrow" data-phs-next aria-label="Nächstes Produkt">
        <span class="phs__arrow-icon" aria-hidden="true">
          <img src={arrowRight} alt="" width="6" height="10" />
        </span>
      </button>
    </div>

    <div class="phs__panel" data-phs-panel>
      <div class="phs__panel-inner">
        <h2 class="phs__panel-title" data-phs-name>{initial.name}</h2>
        <p class="phs__panel-body" data-phs-body>{initial.body}</p>
        <button
          type="button"
          class="phs__details-btn"
          data-phs-details-toggle
          aria-expanded="false"
          aria-controls="phs-details-panel"
        >
          <span class="phs__details-chevron" aria-hidden="true">∨</span>
          Details
        </button>
        <div class="phs__details" id="phs-details-panel" data-phs-details hidden>
          <div class="phs__details-list" data-phs-details-list>
            {
              initial.details.map((item) => (
                <div class="phs__details-item">
                  <p class="phs__details-item-title">{item.title}</p>
                  <p class="phs__details-item-body">{item.body}</p>
                </div>
              ))
            }
          </div>
          <a class="phs__details-link" href={initial.href} data-phs-info>
            Zum Produkt
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/product-header-slider.ts';
</script>

<style>
  .phs {
    position: relative;
    isolation: isolate;
    min-height: 956px;
    height: 100dvh;
    max-height: 1258px;
    overflow: hidden;
    color: var(--color-cream);
    background: #1d2228;
    outline: none;
  }

  .phs__blue-shine {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .phs__blue-top {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 74%;
    opacity: 0.29;
    background: linear-gradient(215.29deg, rgb(62, 144, 198) 3.3%, rgba(62, 144, 198, 0) 61%);
  }

  .phs__blue-bottom {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 56%;
    height: 42%;
    opacity: 0.29;
    background: linear-gradient(249.16deg, rgb(62, 144, 198) 6.4%, rgba(62, 144, 198, 0) 47%);
    transform: rotate(180deg);
    transform-origin: center;
  }

  .phs__raster {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.5;
    overflow: hidden;
  }

  .phs__raster-grid {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    opacity: 0.2;
  }

  .phs__raster-row {
    display: flex;
    margin-bottom: -0.5px;
  }

  .phs__raster-cell {
    flex: 0 0 auto;
    width: 284px;
    height: 284px;
    margin-right: -0.5px;
    border: 0.5px solid var(--color-cream);
    box-sizing: border-box;
  }

  .phs__hit {
    position: absolute;
    inset: 0 0 33.33% 0;
    z-index: 1;
    background: transparent;
  }

  .phs__slogan {
    position: absolute;
    left: 48px;
    top: 231px;
    z-index: 3;
    margin: 0;
    padding-bottom: 24px;
    width: 101px;
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    line-height: 20px;
    color: var(--color-cream);
  }

  .phs__karusell {
    position: absolute;
    left: 0;
    right: 0;
    top: 340px;
    height: 616px;
    z-index: 2;
  }

  .phs__wrap {
    position: absolute;
    inset: 0 0 22% 0;
    overflow: hidden;
  }

  .phs__reihe {
    position: absolute;
    left: 50%;
    top: 0;
    display: flex;
    align-items: flex-start;
    gap: 110px;
    transform: translateX(-50%);
  }

  .phs__tile {
    position: relative;
    flex: 0 0 auto;
  }

  .phs__tile--small {
    display: none;
    width: 280px;
    height: 280px;
  }

  .phs__tile--big {
    width: min(392px, calc(100vw - 48px));
    height: min(392px, calc(100vw - 48px));
  }

  .phs__foto {
    position: relative;
    width: 100%;
    height: 100%;
    box-shadow: 0 0 10.5px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  a.phs__foto--link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .phs__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phs__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .phs__veil--big {
    background: rgba(0, 0, 0, 0.2);
  }

  .phs__veil--small {
    background: rgba(37, 86, 119, 0.6);
  }

  .phs__arrows {
    position: absolute;
    inset: 0 0 42% 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 12px;
    pointer-events: none;
  }

  .phs__arrow {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-cream);
    cursor: pointer;
    transition: transform var(--duration) var(--ease);
  }

  .phs__arrow:hover {
    transform: scale(1.04);
  }

  .phs__arrow:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 3px;
  }

  .phs__arrow-icon {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    overflow: hidden;
  }

  .phs__arrow-icon img {
    width: 6px;
    height: 10px;
    display: block;
    filter: brightness(0) saturate(100%) invert(24%) sepia(8%) saturate(643%) hue-rotate(169deg);
  }

  .phs__panel {
    position: absolute;
    left: 50%;
    top: calc(50% + 210px);
    transform: translate(-50%, -50%);
    z-index: 3;
    width: min(28rem, calc(100vw - 3rem));
    text-align: center;
  }

  .phs__panel-inner {
    border-inline: 1px solid #3e90c6;
    padding: 1rem 1.35rem 1.35rem;
  }

  .phs__panel-title {
    margin: 0 0 0.85rem;
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-cream);
  }

  .phs__panel-body {
    margin: 0 0 1.25rem;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.5;
    color: var(--color-cream);
    opacity: 0.95;
  }

  .phs__details-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.45rem 1.35rem;
    border: 1.5px solid var(--color-cream);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-cream);
    font: inherit;
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .phs__details-btn:hover,
  .phs__details-btn:focus-visible {
    background: color-mix(in srgb, var(--color-cream) 12%, transparent);
  }

  .phs__details-btn:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 3px;
  }

  .phs__details-chevron {
    display: inline-block;
    font-size: 0.85em;
    line-height: 1;
    transition: transform var(--duration) var(--ease);
  }

  .phs.is-details-open .phs__details-chevron {
    transform: rotate(180deg);
  }

  .phs__details {
    margin-top: 1.25rem;
    text-align: left;
  }

  .phs__details[hidden] {
    display: none;
  }

  .phs__details-list {
    display: grid;
    gap: 1rem;
  }

  .phs__details-item-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-cream);
  }

  .phs__details-item-body {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-cream) 88%, transparent);
  }

  .phs__details-link {
    display: inline-flex;
    margin-top: 1.15rem;
    color: #3e90c6;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .phs__details-link:hover,
  .phs__details-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .phs.is-details-open {
    overflow: auto;
    max-height: none;
    height: auto;
    min-height: 100dvh;
  }

  /* Tablet hoch — Figma 768 × 1258 header */
  @media (min-width: 768px) {
    .phs {
      min-height: 1024px;
      height: auto;
      aspect-ratio: 768 / 1258;
      max-height: none;
    }

    .phs.is-details-open {
      aspect-ratio: auto;
    }

    .phs__karusell {
      top: 280px;
      height: 720px;
    }

    .phs__tile--big {
      width: 440px;
      height: 440px;
    }

    .phs__tile--small {
      display: block;
    }

    .phs__reihe {
      align-items: flex-end;
      gap: 160px;
      top: 24px;
    }

    .phs__wrap {
      inset: 0;
    }

    .phs__arrows {
      inset: 28% 3.2% 42% 3.2%;
      padding-inline: 0;
    }

    .phs__panel {
      top: calc(50% + 270px);
      width: min(28rem, 70vw);
    }
  }

  /* Tablet quer — Figma 1024 × 768 */
  @media (min-width: 1024px) {
    .phs {
      min-height: 768px;
      height: 100dvh;
      aspect-ratio: auto;
      max-height: 900px;
    }

    .phs.is-details-open {
      max-height: none;
      height: auto;
    }

    .phs__raster-grid {
      left: 0;
      top: 0;
    }

    .phs__slogan {
      top: 231px;
    }

    .phs__karusell {
      top: 200px;
      height: 560px;
    }

    .phs__reihe {
      gap: 200px;
      top: 5px;
    }

    .phs__tile--big {
      width: 360px;
      height: 360px;
    }

    .phs__tile--big .phs__foto {
      height: 360px;
      margin-top: 0;
    }

    .phs__tile--small {
      width: 220px;
      height: 220px;
    }

    .phs__arrows {
      inset: 32% 3.2% 42% 3.2%;
    }

    .phs__panel {
      top: calc(50% + 230px);
    }
  }

  /* Desktop — Figma 1440 × 900 */
  @media (min-width: 1280px) {
    .phs {
      min-height: 900px;
      height: 100dvh;
      max-height: none;
    }

    .phs__blue-top {
      height: 668px;
      background: linear-gradient(191.51deg, rgb(62, 144, 198) 3.3%, rgba(62, 144, 198, 0) 61%);
    }

    .phs__blue-bottom {
      left: 0;
      top: 520px;
      bottom: auto;
      width: 802px;
      height: 380px;
      background: linear-gradient(217.07deg, rgb(62, 144, 198) 6.4%, rgba(62, 144, 198, 0) 47%);
    }

    .phs__raster-grid {
      left: -260px;
      top: -272px;
    }

    .phs__karusell {
      top: 160px;
      height: 720px;
    }

    .phs__wrap {
      inset: 0 -0.07% 0 0.07%;
    }

    .phs__reihe {
      left: calc(50% + 4px);
      top: 5px;
      gap: 256px;
      align-items: flex-end;
    }

    .phs__tile--big {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      width: 440px;
      height: 440px;
      padding-bottom: 0;
      box-sizing: border-box;
    }

    .phs__tile--big .phs__foto {
      position: relative;
      width: 431px;
      height: 431px;
      flex: 0 0 auto;
    }

    .phs__tile--small {
      width: 280px;
      height: 280px;
    }

    .phs__arrows {
      inset: 28% 3.26% 48% 3.33%;
    }

    .phs__panel {
      top: calc(50% + 280px);
      width: min(30rem, 36vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phs__arrow,
    .phs__details-chevron {
      transition: none;
    }
  }
</style>
