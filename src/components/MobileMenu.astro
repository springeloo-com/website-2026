---
import type { NavItem } from '../data/navigation';
import NavLink from './NavLink.astro';
import CTAButton from './CTAButton.astro';

interface Props {
  items: NavItem[];
  activePath: string;
}

const { items, activePath } = Astro.props;
const panelId = 'mobile-menu-panel';

const isActive = (href: string) => {
  if (href === '/') return activePath === '/';
  return activePath === href || activePath.startsWith(`${href}/`);
};
---

<div class="mobile-menu" data-mobile-menu>
  <button
    type="button"
    class="mobile-menu__burger"
    aria-expanded="false"
    aria-controls={panelId}
    data-mobile-menu-toggle
  >
    <span class="sr-only">Menü öffnen</span>
    <span class="mobile-menu__icon" aria-hidden="true"></span>
  </button>

  <div class="mobile-menu__panel" id={panelId} hidden data-mobile-menu-panel>
    <nav aria-label="Mobile Navigation">
      <ul>
        {
          items.map((item) => (
            <li>
              <NavLink href={item.href} label={item.label} current={isActive(item.href)} class="mobile-menu__link" />
              {item.children?.length ? (
                <ul class="mobile-menu__sub">
                  {item.children.map((child) => (
                    <li>
                      <NavLink href={child.href} label={child.label} />
                    </li>
                  ))}
                </ul>
              ) : null}
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__cta">
        <CTAButton label="jetzt vernetzen" href="/kontakt" variant="ghost-light" />
      </div>
    </nav>
  </div>
</div>

<style>
  .mobile-menu {
    display: block;
  }

  .mobile-menu__burger {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    background: transparent;
    color: inherit;
    display: grid;
    place-items: center;
  }

  .mobile-menu__icon,
  .mobile-menu__icon::before,
  .mobile-menu__icon::after {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: currentColor;
    position: relative;
  }

  .mobile-menu__icon::before,
  .mobile-menu__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .mobile-menu__icon::before {
    top: -5px;
  }

  .mobile-menu__icon::after {
    top: 5px;
  }

  .mobile-menu__panel {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    background: var(--color-blue);
    color: var(--color-white);
    padding: var(--space-6) var(--space-5);
    overflow: auto;
    z-index: 50;
  }

  .mobile-menu__panel[hidden] {
    display: none;
  }

  .mobile-menu__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .mobile-menu__link {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
  }

  .mobile-menu__sub {
    margin-top: var(--space-3) !important;
    padding-left: var(--space-3) !important;
    gap: var(--space-2) !important;
  }

  .mobile-menu__cta {
    margin-top: var(--space-7);
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
