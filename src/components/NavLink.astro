---
interface Props {
  href: string;
  label: string;
  current?: boolean;
  class?: string;
}

const { href, label, current = false, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const resolved = href.startsWith('http') || href.startsWith('#')
  ? href
  : `${base}${href.startsWith('/') ? href : `/${href}`}`;
---

<a
  class:list={['nav-link', className]}
  href={resolved}
  aria-current={current ? 'page' : undefined}
>
  <span class="nav-link__stack">
    <span class="nav-link__label">{label}</span>
    <span class="nav-link__underline" aria-hidden="true"></span>
  </span>
</a>

<style>
  /*
    Figma menue-point-01 (Desktop: Arrow=false)
    Hover: underline 0 → full width, Smart Animate 300ms ease-out
    “Shine”: cream underline with soft glow (matches luminous menu sheen)
  */
  .nav-link {
    display: inline-flex;
    font-size: inherit;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.42px;
    line-height: 1.2;
    text-decoration: none !important;
    white-space: nowrap;
    color: inherit;
  }

  .nav-link:hover,
  .nav-link:focus,
  .nav-link:focus-visible,
  .nav-link:active {
    text-decoration: none !important;
  }

  .nav-link__stack {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    width: max-content;
  }

  .nav-link__label {
    display: block;
  }

  .nav-link__underline {
    display: block;
    height: 1px;
    width: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      transform 300ms ease-out,
      box-shadow 300ms ease-out,
      filter 300ms ease-out;
    will-change: transform;
    box-shadow: none;
  }

  .nav-link:hover .nav-link__underline,
  .nav-link:focus-visible .nav-link__underline {
    transform: scaleX(1);
    /* Soft shine along the grown underline */
    box-shadow:
      0 0 6px color-mix(in srgb, currentColor 70%, transparent),
      0 0 14px color-mix(in srgb, currentColor 35%, transparent);
    filter: brightness(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link__underline {
      transition: none;
    }
  }
</style>
