---
import type { NavChild } from '../data/navigation';
import NavLink from './NavLink.astro';

interface Props {
  label: string;
  href: string;
  current?: boolean;
  items: NavChild[];
}

const { label, href, current = false, items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const parentHref = `${base}${href.startsWith('/') ? href : `/${href}`}`;
---

<div class="expandable" data-expandable>
  <div class="expandable__row">
    <a class="expandable__parent" href={parentHref} aria-current={current ? 'page' : undefined}>{label}</a>
    <button
      type="button"
      class="expandable__toggle"
      aria-expanded="false"
      data-expandable-toggle
    >
      <span class="sr-only">{label} Untermenü</span>
      <span aria-hidden="true">▾</span>
    </button>
  </div>
  <ul class="expandable__panel" hidden data-expandable-panel>
    {
      items.map((child) => (
        <li>
          <NavLink href={child.href} label={child.label} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .expandable {
    position: relative;
  }

  .expandable__row {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .expandable__parent {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .expandable__toggle {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0.2rem;
    line-height: 1;
  }

  .expandable__panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    min-width: 14rem;
    margin: 0;
    padding: var(--space-3);
    list-style: none;
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
    display: grid;
    gap: var(--space-2);
  }

  .expandable__panel[hidden] {
    display: none;
  }
</style>
