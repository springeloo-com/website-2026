---
interface Props {
  label: string;
  href: string;
  variant?: 'primary' | 'ghost' | 'ghost-light' | 'dark';
  class?: string;
}

const { label, href, variant = 'primary', class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const resolved = href.startsWith('http') || href.startsWith('#')
  ? href
  : `${base}${href.startsWith('/') ? href : `/${href}`}`;
---

<a class:list={['cta', `cta--${variant}`, className]} href={resolved}>
  <span>{label}</span>
  <span class="cta__chevron" aria-hidden="true">›</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: transform var(--duration) var(--ease), background var(--duration) var(--ease);
  }

  .cta:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .cta--primary {
    background: var(--color-blue);
    color: var(--color-white);
  }

  .cta--ghost,
  .cta--ghost-light {
    background: transparent;
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .cta--dark {
    background: transparent;
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .cta__chevron {
    font-size: 1.1em;
    line-height: 1;
  }
</style>
