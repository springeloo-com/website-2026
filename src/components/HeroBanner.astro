---
import '@fontsource/overpass-mono/700.css';
import CTAButton from './CTAButton.astro';
import GradAnimation from './GradAnimation.astro';
import HeroShine from './HeroShine.astro';
import { publicUrl } from '../lib/content';

interface Props {
  eyebrow?: string;
  headline: string;
  imageSrc: string;
  imageAlt: string;
  badge?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow = 'Digitale Tools und Kompetenzen',
  headline,
  imageSrc,
  imageAlt,
  badge = 'HR+AI',
  primaryCta = { label: 'Personal', href: '/projektunterstuetzung' },
  secondaryCta = { label: 'Produkte', href: '/produkte' },
} = Astro.props;

const hrAiLines = badge.replace(/\s+/g, '').includes('+')
  ? badge.replace(/\s+/g, '').split('+')
  : ['HR', 'AI'];
---

<section class="hero-banner" aria-label="Hero">
  <img class="hero-banner__image" src={imageSrc} alt={imageAlt} />

  <div class="hero-banner__raster" aria-hidden="true"></div>
  <HeroShine />
  <div class="hero-banner__hit" data-interaktionsflaeche aria-hidden="true"></div>

  <p class="hero-banner__tag">
    {Astro.slots.has('tag') ? (
      <slot name="tag" />
    ) : (
      <>
        future by
        <br aria-hidden="true" />
        professionals.
      </>
    )}
  </p>

  <div class="hero-combined">
    <div class="hero-combined__hrai-row">
      <div class="hero-combined__hrai" aria-hidden="true">
        <GradAnimation />
        <div
          class="hero-combined__hrai-text"
          style={`background-image: url('${publicUrl('/uploads/effects/hr-ai-texture.png')}')`}
        >
          <p>{hrAiLines[0]}+</p>
          <p>{hrAiLines[1] ?? 'AI'}</p>
        </div>
      </div>
    </div>

    <div class="hero-combined__card">
      <GradAnimation />
      <div class="hero-combined__card-inner">
        <div class="hero-combined__copy">
          {
            eyebrow && (
              <p class="hero-combined__eyebrow">
                {eyebrow.split('\n').map((line, index) => (
                  <>
                    {index > 0 && <br aria-hidden="true" />}
                    {line}
                  </>
                ))}
              </p>
            )
          }
          <h1 class="hero-combined__headline">{headline}</h1>
        </div>
        <div class="hero-combined__actions">
          <CTAButton label={primaryCta.label} href={primaryCta.href} variant="ghost-light" />
          <CTAButton label={secondaryCta.label} href={secondaryCta.href} variant="ghost-light" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    color: var(--color-cream);
    overflow: hidden;

    --hero-grid-cell: 200px;
    --hero-grid-x: -187px;
    --hero-grid-y: -59px;
    --hero-card-w: 399px;
    --hero-box-h: 199.5px;
    --hero-hr-w: 28px;
    --hero-hr-offset: 399px;
    --hero-card-pad: 12px;
    --hero-text-gap: 8px;
    --hero-eyebrow-size: 16px;
    --hero-eyebrow-lh: 20px;
    --hero-headline-size: 24px;
    --hero-hr-font: 10px;
    --hero-hr-tracking: 1.3px;
  }

  .hero-banner__image {
    position: absolute;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: calc(100% - var(--header-height));
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__raster {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.5;
    background-image:
      linear-gradient(to right, var(--color-cream) 0.5px, transparent 0.5px),
      linear-gradient(to bottom, var(--color-cream) 0.5px, transparent 0.5px);
    background-size: var(--hero-grid-cell) var(--hero-grid-cell);
    background-position: var(--hero-grid-x) var(--hero-grid-y);
  }

  .hero-banner__hit {
    display: none;
    position: absolute;
    inset: 0 0 33.33% 0;
    z-index: 3;
  }

  .hero-banner__tag {
    position: absolute;
    z-index: 2;
    margin: 0;
    left: 24px;
    top: 224px;
    width: 101px;
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    line-height: 20px;
    color: var(--color-cream);
  }

  .hero-combined {
    position: absolute;
    z-index: 4;
    left: 13px;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: calc(var(--hero-card-w) + var(--hero-hr-w));
    max-width: calc(100% - 13px);
  }

  .hero-combined__hrai-row {
    display: flex;
    align-items: center;
    padding-left: min(var(--hero-hr-offset), calc(100% - var(--hero-hr-w)));
  }

  .hero-combined__hrai,
  .hero-combined__card {
    position: relative;
    background: var(--color-blue);
    overflow: hidden;
  }

  .hero-combined__hrai {
    width: var(--hero-hr-w);
    height: var(--hero-box-h);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding-bottom: 12px;
    flex-shrink: 0;
  }

  .hero-combined__hrai-text {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    min-height: 0;
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-weight: 700;
    font-size: var(--hero-hr-font);
    letter-spacing: var(--hero-hr-tracking);
    line-height: 0.88;
    text-align: center;
    opacity: 0.2;
    mix-blend-mode: overlay;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-combined__hrai-text p {
    margin: 0;
  }

  .hero-combined__card {
    width: var(--hero-card-w);
    max-width: calc(100% - var(--hero-hr-w));
    height: var(--hero-box-h);
  }

  .hero-combined__card-inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--hero-card-pad);
  }

  .hero-combined__copy {
    display: flex;
    flex-direction: column;
    gap: var(--hero-text-gap);
  }

  .hero-combined__eyebrow {
    margin: 0;
    font-size: var(--hero-eyebrow-size);
    font-weight: var(--font-weight-bold);
    line-height: var(--hero-eyebrow-lh);
    color: var(--color-white);
    white-space: pre-wrap;
  }

  .hero-combined__headline {
    margin: 0;
    font-size: var(--hero-headline-size);
    font-weight: var(--font-weight-regular);
    line-height: 1.16;
    letter-spacing: 0;
    color: var(--color-white);
    mix-blend-mode: soft-light;
  }

  .hero-combined__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-combined__actions :global(.cta) {
    height: 36px;
    padding: 8px 24px;
    border-width: 1.5px;
    font-size: 16px;
    font-weight: var(--font-weight-bold);
    gap: 8px;
  }

  @media (min-width: 768px) {
    .hero-banner {
      --hero-grid-cell: 240px;
      --hero-grid-x: -215px;
      --hero-grid-y: -227px;
      --hero-card-w: 479px;
      --hero-box-h: 239px;
      --hero-hr-w: 239px;
      --hero-hr-offset: 479px;
      --hero-card-pad: 20px;
      --hero-text-gap: 14px;
      --hero-eyebrow-size: 16px;
      --hero-eyebrow-lh: 20px;
      --hero-headline-size: 28px;
      --hero-hr-font: 60px;
      --hero-hr-tracking: 7.8px;
    }

    .hero-banner__image {
      inset: 0;
      height: 100%;
    }

    .hero-banner__hit {
      display: block;
    }

    .hero-banner__tag {
      left: 48px;
      top: 188px;
    }

    .hero-combined {
      left: 25px;
      right: auto;
      bottom: 54px;
      max-width: none;
    }

    .hero-combined__hrai {
      padding-bottom: 0;
    }

    .hero-combined__hrai-text {
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner {
      --hero-grid-cell: 224px;
      --hero-grid-x: -317px;
      --hero-grid-y: -211px;
      --hero-card-w: 447px;
      --hero-box-h: 223px;
      --hero-hr-w: 223px;
      --hero-hr-offset: 447px;
    }

    .hero-banner__tag {
      top: 172px;
    }

    .hero-combined {
      left: auto;
      right: 0;
      bottom: 85px;
    }
  }

  @media (min-width: 1280px) {
    .hero-banner {
      --hero-grid-cell: 284px;
      --hero-grid-x: -260px;
      --hero-grid-y: -272px;
      --hero-card-w: 567px;
      --hero-box-h: 284px;
      --hero-hr-w: 284px;
      --hero-hr-offset: 567px;
      --hero-card-pad: 24px;
      --hero-eyebrow-size: 20px;
      --hero-eyebrow-lh: 24px;
      --hero-headline-size: 35px;
    }

    .hero-banner__tag {
      top: 231px;
    }

    .hero-combined {
      bottom: 37px;
    }
  }
</style>
