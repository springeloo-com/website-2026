---
import CTAButton from './CTAButton.astro';
import HeroShine from './HeroShine.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  imageSrc: string;
  imageAlt: string;
  badge?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow = 'Digitale Tools und Kompetenzen',
  headline,
  imageSrc,
  imageAlt,
  badge = 'HR + AI',
  primaryCta = { label: 'Personal', href: '/projektunterstuetzung' },
  secondaryCta = { label: 'Produkte', href: '/produkte' },
} = Astro.props;
---

<section class="hero-banner" aria-label="Hero">
  <img class="hero-banner__image" src={imageSrc} alt={imageAlt} />
  <div class="hero-banner__shade" aria-hidden="true"></div>
  <HeroShine />
  <div class="grid-overlay" aria-hidden="true"></div>
  <div class="hero-banner__content container">
    <p class="hero-banner__tag">{Astro.slots.has('tag') ? <slot name="tag" /> : 'future by professionals.'}</p>
    <div class="hero-banner__stack">
      {
        badge && (
          <div class="hero-banner__badge" aria-hidden="true">
            <span>{badge}</span>
          </div>
        )
      }
      <div class="hero-banner__card">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{headline}</h1>
        <div class="hero-banner__actions">
          <CTAButton label={primaryCta.label} href={primaryCta.href} variant="ghost-light" />
          <CTAButton label={secondaryCta.label} href={secondaryCta.href} variant="ghost-light" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    color: var(--color-white);
    overflow: hidden;
    display: grid;
  }

  .hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 48%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 40%),
      rgba(0, 0, 0, 0.12);
    z-index: 1;
  }

  .hero-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: calc(var(--header-height) + var(--space-5)) 0;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .hero-banner__tag {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    max-width: 12rem;
    line-height: 1.25;
  }

  /* Mobile: card + vertical HR+AI strip (Figma 2109:114327) */
  .hero-banner__stack {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
  }

  .hero-banner__badge {
    order: 2;
    background: var(--color-blue);
    display: grid;
    place-items: center;
    width: 1.75rem;
    flex: 0 0 1.75rem;
    padding: var(--space-3) 0;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    font-size: 0.65rem;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
  }

  .hero-banner__card {
    order: 1;
    flex: 1 1 auto;
    min-width: 0;
    background: var(--color-blue);
    padding: var(--space-3) var(--space-4);
    display: grid;
    gap: var(--space-3);
    align-content: space-between;
    min-height: 12.5rem;
  }

  .hero-banner__card .eyebrow {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
  }

  .hero-banner__card h1 {
    margin: 0;
    font-size: clamp(1.35rem, 4.2vw, 2.2rem);
    line-height: 1.16;
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-regular);
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Tablet hoch — stack badge above card, lower band (Figma 2109:104991) */
  @media (min-width: 768px) {
    .hero-banner__content {
      padding-block: calc(var(--header-height) + var(--space-6)) var(--space-6);
    }

    .hero-banner__tag {
      margin-top: var(--space-2);
      font-size: var(--font-size-md);
      max-width: none;
    }

    .hero-banner__stack {
      flex-direction: column;
      align-items: flex-start;
      width: min(100%, 30rem);
      align-self: flex-start;
    }

    .hero-banner__badge {
      order: 0;
      writing-mode: horizontal-tb;
      transform: none;
      width: 14.9rem;
      flex: none;
      aspect-ratio: 1;
      padding: 0;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      letter-spacing: 0.08em;
      line-height: 0.88;
      text-align: center;
      opacity: 0.95;
    }

    .hero-banner__card {
      order: 0;
      width: 100%;
      max-width: 30rem;
      min-height: 14.9rem;
      padding: var(--space-5);
      gap: var(--space-4);
    }
  }

  /* Tablet quer — right cluster, badge atop card width (Figma 2109:91364) */
  @media (min-width: 1024px) {
    .hero-banner__stack {
      align-self: flex-end;
      width: min(100%, 27.9rem);
      align-items: flex-end;
    }

    .hero-banner__badge {
      width: 13.9rem;
    }

    .hero-banner__card {
      max-width: 27.9rem;
      min-height: 13.9rem;
      padding: 1.25rem;
    }

    .hero-banner__tag {
      margin-top: var(--space-4);
    }
  }

  /* Desktop — 567×284 card + 284 badge (Figma 2109:78609) */
  @media (min-width: 1280px) {
    .hero-banner__content {
      padding-block: calc(var(--header-height) + var(--space-6)) 0;
    }

    .hero-banner__stack {
      width: min(100%, 35.4rem);
      margin-bottom: 0;
    }

    .hero-banner__badge {
      width: 17.75rem;
      font-size: 2.5rem;
      letter-spacing: 0.13em;
    }

    .hero-banner__card {
      max-width: 35.4rem;
      min-height: 17.75rem;
      padding: 1.5rem;
    }

    .hero-banner__card h1 {
      font-size: clamp(1.75rem, 2.4vw, 2.2rem);
    }

    .hero-banner__tag {
      margin-top: var(--space-6);
    }
  }
</style>
