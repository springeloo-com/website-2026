---
/**
 * Figma Header-clip-01 — home first viewport
 * Desktop 2099:107247 · Tablet quer I2109:91364;2099:110397 · Tablet hoch I2109:104991;2099:113852
 */
import '@fontsource/overpass-mono/700.css';
import CTAButton from './CTAButton.astro';
import GradAnimation from './GradAnimation.astro';
import HeroShine from './HeroShine.astro';
import { publicUrl } from '../lib/content';

interface Props {
  eyebrow?: string;
  headline: string;
  imageSrc: string;
  imageAlt: string;
  badge?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  eyebrow = 'Digitale Tools und Kompetenzen',
  headline,
  imageSrc,
  imageAlt,
  badge = 'HR + AI',
  primaryCta = { label: 'Personal', href: '/projektunterstuetzung' },
  secondaryCta = { label: 'Produkte', href: '/produkte' },
} = Astro.props;

const hrAiLines = badge.replace(/\s+/g, '').includes('+')
  ? badge.replace(/\s+/g, '').split('+')
  : ['HR', 'AI'];

/** Figma headline breaks after “Digitale ” / “Unternehmenskultur” */
const headlineHtml = (() => {
  const match = headline.match(/^(Digitale\s+)(Unternehmenskultur)(\s*)(durch\s+.+)$/i);
  if (!match) return null;
  return { lead: match[1], mid: match[2], rest: match[4] };
})();
---

<section class="hero-banner" aria-label="Hero">
  <img class="hero-banner__image" src={imageSrc} alt={imageAlt} width="2880" height="1800" decoding="async" />

  <div class="hero-banner__raster" aria-hidden="true"></div>
  <HeroShine />
  <div class="hero-banner__hit" data-interaktionsflaeche aria-hidden="true"></div>

  <p class="hero-banner__tag">
    {
      Astro.slots.has('tag') ? (
        <slot name="tag" />
      ) : (
        <>
          future by
          <br aria-hidden="true" />
          professionals.
        </>
      )
    }
  </p>

  <div class="hero-combined">
    <div class="hero-combined__hrai-row">
      <div class="hero-combined__hrai" aria-hidden="true">
        <GradAnimation />
        <div
          class="hero-combined__hrai-text"
          style={`background-image: url('${publicUrl('/uploads/effects/hr-ai-texture.png')}')`}
        >
          <p>{hrAiLines[0]}+</p>
          <p>{hrAiLines[1] ?? 'AI'}</p>
        </div>
      </div>
    </div>

    <div class="hero-combined__card">
      <GradAnimation />
      <div class="hero-combined__card-inner">
        <div class="hero-combined__copy">
          {
            eyebrow && (
              <p class="hero-combined__eyebrow">
                {eyebrow.split('\n').map((line, index) => (
                  <>
                    {index > 0 && <br aria-hidden="true" />}
                    {line}
                  </>
                ))}
              </p>
            )
          }
          <h1 class="hero-combined__headline">
            {
              headlineHtml ? (
                <>
                  <span class="hero-combined__headline-line">
                    {headlineHtml.lead}
                    <span class="hero-combined__headline-em">{headlineHtml.mid}</span>
                  </span>
                  <span class="hero-combined__headline-line">{headlineHtml.rest}</span>
                </>
              ) : (
                headline
              )
            }
          </h1>
        </div>
        <div class="hero-combined__actions">
          <CTAButton label={primaryCta.label} href={primaryCta.href} variant="ghost-light" />
          <CTAButton label={secondaryCta.label} href={secondaryCta.href} variant="ghost-light" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    /* Figma Header-clip mobile canvas 440×956 */
    min-height: 100vh;
    min-height: 100dvh;
    height: 100dvh;
    max-height: 1258px;
    color: var(--color-cream);
    overflow: hidden;
    background: #1d2228;

    --hero-grid-cell: 200px;
    --hero-grid-x: -187px;
    --hero-grid-y: -59px;
    --hero-card-w: 399px;
    --hero-box-h: 199.5px;
    --hero-hr-w: 28px;
    --hero-hr-offset: 399px;
    --hero-card-pad: 12px;
    --hero-text-gap: 8px;
    --hero-eyebrow-size: 16px;
    --hero-eyebrow-lh: 20px;
    --hero-headline-size: 24px;
    --hero-hr-font: 10px;
    --hero-hr-tracking: 1.3px;
    --hero-wrap-left: 13px;
    --hero-wrap-top: 540px;
    --hero-wrap-bottom: auto;
  }

  .hero-banner__image {
    position: absolute;
    /* Figma mobile Image starts below menue (y=148) */
    top: var(--header-height, 148px);
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: calc(100% - var(--header-height, 148px));
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-banner :global(.hero-shine) {
    display: none;
  }

  .hero-banner__raster {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Figma Raster opacity 50% × row opacity 50% */
    opacity: 0.25;
    background-image:
      linear-gradient(to right, var(--color-cream) 0.5px, transparent 0.5px),
      linear-gradient(to bottom, var(--color-cream) 0.5px, transparent 0.5px);
    background-size: var(--hero-grid-cell) var(--hero-grid-cell);
    background-position: var(--hero-grid-x) var(--hero-grid-y);
  }

  .hero-banner__hit {
    display: none;
    position: absolute;
    inset: 0 0 33.33% 0;
    z-index: 3;
  }

  .hero-banner__tag {
    position: absolute;
    z-index: 2;
    margin: 0;
    left: 24px;
    top: 280px;
    width: 101px;
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    line-height: 20px;
    color: var(--color-cream);
  }

  .hero-combined {
    position: absolute;
    z-index: 4;
    left: var(--hero-wrap-left);
    top: var(--hero-wrap-top);
    bottom: var(--hero-wrap-bottom);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(427px, calc(100% - 13px));
    max-width: calc(100% - 13px);
  }

  .hero-combined__hrai-row {
    display: flex;
    align-items: center;
    padding-left: min(var(--hero-hr-offset), calc(100% - var(--hero-hr-w)));
  }

  .hero-combined__hrai,
  .hero-combined__card {
    position: relative;
    background: var(--color-blue);
    overflow: hidden;
  }

  .hero-combined__hrai {
    width: var(--hero-hr-w);
    height: var(--hero-box-h);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding-bottom: 12px;
    flex-shrink: 0;
  }

  .hero-combined__hrai-text {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    min-height: 0;
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-weight: 700;
    font-size: var(--hero-hr-font);
    letter-spacing: var(--hero-hr-tracking);
    line-height: 0.88;
    text-align: center;
    opacity: 0.2;
    mix-blend-mode: overlay;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-combined__hrai-text p {
    margin: 0;
  }

  .hero-combined__card {
    width: var(--hero-card-w);
    max-width: calc(100% - var(--hero-hr-w));
    height: var(--hero-box-h);
  }

  .hero-combined__card-inner {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--hero-card-pad);
  }

  .hero-combined__copy {
    display: flex;
    flex-direction: column;
    gap: var(--hero-text-gap);
    min-width: 0;
  }

  .hero-combined__eyebrow {
    margin: 0;
    font-size: var(--hero-eyebrow-size);
    font-weight: var(--font-weight-bold);
    line-height: var(--hero-eyebrow-lh);
    color: var(--color-white);
    white-space: pre-wrap;
  }

  .hero-combined__headline {
    margin: 0;
    font-size: var(--hero-headline-size);
    font-weight: var(--font-weight-regular);
    line-height: 1.16;
    letter-spacing: 0;
    color: var(--color-white);
    mix-blend-mode: soft-light;
  }

  .hero-combined__headline-line {
    display: block;
  }

  .hero-combined__headline-em {
    color: var(--color-white);
  }

  .hero-combined__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }

  .hero-combined__actions :global(.cta) {
    height: 36px;
    padding: 8px 24px;
    border-width: 1.5px;
    border-color: var(--color-cream);
    color: var(--color-cream);
    font-size: 16px;
    font-weight: var(--font-weight-bold);
    gap: 8px;
  }

  .hero-combined__actions :global(.cta:hover) {
    background: color-mix(in srgb, var(--color-cream) 12%, transparent);
  }

  /* Tablet hoch — Figma 768×1024, combined-boxes at 25,492 · 718×478 */
  @media (min-width: 768px) {
    .hero-banner {
      --hero-grid-cell: 240px;
      --hero-grid-x: -215px;
      --hero-grid-y: -227px;
      --hero-card-w: 479px;
      --hero-box-h: 239px;
      --hero-hr-w: 239px;
      --hero-hr-offset: 479px;
      --hero-card-pad: 20px;
      --hero-text-gap: 14px;
      --hero-eyebrow-size: 16px;
      --hero-eyebrow-lh: 20px;
      --hero-headline-size: 28px;
      --hero-hr-font: 60px;
      --hero-hr-tracking: 7.8px;
      --hero-wrap-left: 25px;
      --hero-wrap-top: 492px;
      --hero-wrap-bottom: auto;
      height: auto;
      min-height: 1024px;
      aspect-ratio: 768 / 1024;
      max-height: none;
    }

    .hero-banner__image {
      top: 0;
      height: 100%;
      object-position: center;
    }

    .hero-banner :global(.hero-shine) {
      display: block;
    }

    .hero-banner__hit {
      display: block;
    }

    .hero-banner__tag {
      left: 48px;
      top: 188px;
    }

    .hero-combined {
      width: 718px;
      max-width: none;
    }

    .hero-combined__hrai {
      padding-bottom: 0;
    }

    .hero-combined__hrai-text {
      justify-content: center;
    }
  }

  /* Tablet quer — Figma 1024×768, combined-boxes at 353,237 · 670×446 */
  @media (min-width: 1024px) {
    .hero-banner {
      --hero-grid-cell: 224px;
      --hero-grid-x: -317px;
      --hero-grid-y: -211px;
      --hero-card-w: 447px;
      --hero-box-h: 223px;
      --hero-hr-w: 223px;
      --hero-hr-offset: 447px;
      --hero-wrap-left: 353px;
      --hero-wrap-top: 237px;
      height: 100dvh;
      min-height: 768px;
      aspect-ratio: auto;
      max-height: 900px;
    }

    .hero-banner__tag {
      top: 172px;
    }

    .hero-combined {
      width: 670px;
    }
  }

  /* Desktop — Figma 1440×900, wrap at 591,295 · 849×568 */
  @media (min-width: 1280px) {
    .hero-banner {
      --hero-grid-cell: 284px;
      --hero-grid-x: -260px;
      --hero-grid-y: -272px;
      --hero-card-w: 567px;
      --hero-box-h: 284px;
      --hero-hr-w: 284px;
      --hero-hr-offset: 567px;
      --hero-card-pad: 24px;
      --hero-eyebrow-size: 20px;
      --hero-eyebrow-lh: 24px;
      --hero-headline-size: 35px;
      --hero-wrap-left: max(0px, calc(100% - 849px));
      --hero-wrap-top: 295px;
      min-height: 900px;
      height: 100dvh;
      max-height: none;
    }

    .hero-banner__tag {
      top: 231px;
    }

    .hero-combined {
      width: 849px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-combined__actions :global(.cta) {
      transition: none;
    }
  }
</style>
