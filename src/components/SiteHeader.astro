---
import { getPrimaryNav } from '../lib/content';
import BrandLogo from './BrandLogo.astro';
import NavLink from './NavLink.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  activePath?: string;
  variant?: 'transparent' | 'solid' | 'solid-dark';
}

const { activePath = '/', variant = 'transparent' } = Astro.props;
const primaryNav = getPrimaryNav();
const mainNav = primaryNav.filter((item) => item.id !== 'kontakt');
const kontaktNav = primaryNav.find((item) => item.id === 'kontakt');

const isActive = (href: string) => {
  if (href === '/') return activePath === '/';
  return activePath === href || activePath.startsWith(`${href}/`);
};

const menueVersionMode = variant === 'transparent' ? 'interactive' : 'static';
---

<header
  class:list={['site-header', `site-header--${variant}`]}
  data-menue-version
  data-menue-version-mode={menueVersionMode}
>
  <div class="site-header__shine" aria-hidden="true"></div>
  <div class="site-header__inner">
    <BrandLogo />

    <nav class="site-header__desktop" aria-label="Hauptnavigation">
      <ul class="site-header__main">
        {
          mainNav.map((item) => (
            <li>
              <NavLink href={item.href} label={item.label} current={isActive(item.href)} />
            </li>
          ))
        }
      </ul>
      {
        kontaktNav && (
          <ul class="site-header__kontakt">
            <li>
              <NavLink href={kontaktNav.href} label={kontaktNav.label} current={isActive(kontaktNav.href)} />
            </li>
          </ul>
        )
      }
    </nav>

    <MobileMenu items={primaryNav} activePath={activePath} />
  </div>
</header>

<script>
  import '../scripts/expandable-menu.ts';
  import '../scripts/header-menue-version.ts';
</script>

<style>
  .site-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 40;
    height: var(--header-height);
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out,
      box-shadow 300ms ease-out;
  }

  .site-header__shine {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    background: linear-gradient(
      125deg,
      transparent 0%,
      transparent 38%,
      color-mix(in srgb, var(--color-cream) 55%, transparent) 52%,
      transparent 68%,
      transparent 100%
    );
    transition: opacity 300ms ease-out;
  }

  .site-header--transparent .site-header__shine {
    opacity: 0.55;
    animation: menue-shine-sweep 5.5s var(--ease) infinite;
  }

  @keyframes menue-shine-sweep {
    0%,
    100% {
      transform: translateX(-8%);
      opacity: 0.35;
    }
    50% {
      transform: translateX(10%);
      opacity: 0.7;
    }
  }

  .site-header--solid {
    position: sticky;
    background: var(--color-cream);
    color: var(--color-ink);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .site-header--solid-dark {
    position: sticky;
    background: var(--color-navy);
    color: var(--color-white);
  }

  .site-header--transparent {
    color: var(--color-cream);
  }

  .site-header--transparent.site-header--hintergrund {
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .site-header--transparent.site-header--hintergrund .site-header__shine {
    opacity: 0.25;
    animation: none;
  }

  /* Mobile only: solid navy chrome over menue-leiste. Tablet-hoch is transparent + burger. */
  @media (max-width: 767.98px) {
    .site-header--transparent {
      background: var(--color-navy);
    }

    .site-header--transparent .site-header__shine {
      display: none;
    }

    .site-header--transparent.site-header--hintergrund {
      background: var(--color-cream);
      color: var(--color-ink);
    }
  }

  /* Figma menue-01: px 24 mobile / 48 tablet+desktop, pb 10, inner 85 */
  .site-header__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      align-items: flex-end;
      padding: 0 48px 10px;
    }
  }

  .site-header :global(.brand-logo__img--ink) {
    display: none;
  }

  .site-header--solid :global(.brand-logo__img--cream),
  .site-header--solid-dark :global(.brand-logo__img--cream),
  .site-header--transparent.site-header--hintergrund :global(.brand-logo__img--cream) {
    display: none;
  }

  .site-header--solid :global(.brand-logo__img--ink),
  .site-header--solid-dark :global(.brand-logo__img--ink),
  .site-header--transparent.site-header--hintergrund :global(.brand-logo__img--ink) {
    display: block;
  }

  .site-header__desktop {
    display: none;
  }

  .site-header__desktop ul {
    display: flex;
    align-items: flex-start;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__main {
    gap: 16px;
  }

  .site-header__desktop :global(a),
  .site-header__desktop :global(a:hover),
  .site-header__desktop :global(a:focus) {
    text-decoration: none !important;
  }

  /* Figma tablet-quer + desktop: full nav, 46px before Kontakt */
  @media (min-width: 1024px) {
    .site-header__desktop {
      display: flex;
      align-items: flex-start;
      gap: 46px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__shine {
      transition: none;
      animation: none;
    }
  }
</style>
