---
import { getPrimaryNav, getSiteMeta } from '../lib/content';
import NavLink from './NavLink.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  activePath?: string;
  variant?: 'transparent' | 'solid' | 'solid-dark';
}

const { activePath = '/', variant = 'transparent' } = Astro.props;
const primaryNav = getPrimaryNav();
const siteMeta = getSiteMeta();

const isActive = (href: string) => {
  if (href === '/') return activePath === '/';
  return activePath === href || activePath.startsWith(`${href}/`);
};

/** Figma menue-01 Version=Transparent can switch to Hintergrund on interaction */
const menueVersionMode = variant === 'transparent' ? 'interactive' : 'static';
---

<header
  class:list={['site-header', `site-header--${variant}`]}
  data-menue-version
  data-menue-version-mode={menueVersionMode}
>
  {/* Figma TransparentDark / menu sheen — soft diagonal cream shine over nav chrome */}
  <div class="site-header__shine" aria-hidden="true"></div>
  <div class="site-header__inner container">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label="springeloo Startseite">
      <span class="brand__mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="brand__name">{siteMeta.name}</span>
    </a>

    <nav class="site-header__desktop" aria-label="Hauptnavigation">
      <ul>
        {
          /* Desktop Figma menue-point-01: Arrow=false, flat links + underline shine */
          primaryNav.map((item) => (
            <li>
              <NavLink href={item.href} label={item.label} current={isActive(item.href)} />
            </li>
          ))
        }
      </ul>
    </nav>

    <MobileMenu items={primaryNav} activePath={activePath} />
  </div>
</header>

<script>
  import '../scripts/expandable-menu.ts';
  import '../scripts/header-menue-version.ts';
</script>

<style>
  .site-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 40;
    height: var(--header-height);
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out,
      box-shadow 300ms ease-out;
  }

  .site-header__shine {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    background: linear-gradient(
      125deg,
      transparent 0%,
      transparent 38%,
      color-mix(in srgb, var(--color-cream) 55%, transparent) 52%,
      transparent 68%,
      transparent 100%
    );
    transition: opacity 300ms ease-out;
  }

  .site-header--transparent .site-header__shine {
    opacity: 0.55;
    animation: menue-shine-sweep 5.5s var(--ease) infinite;
  }

  @keyframes menue-shine-sweep {
    0%,
    100% {
      transform: translateX(-8%);
      opacity: 0.35;
    }
    50% {
      transform: translateX(10%);
      opacity: 0.7;
    }
  }

  .site-header--solid {
    position: sticky;
    background: var(--color-cream);
    color: var(--color-ink);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .site-header--solid-dark {
    position: sticky;
    background: var(--color-navy);
    color: var(--color-white);
  }

  .site-header--transparent {
    /* Figma menue-01 Transparent: cream type */
    color: var(--color-cream);
  }

  /* Figma Version=Hintergrund (Desktop) — cream bar + dark ink */
  .site-header--transparent.site-header--hintergrund {
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .site-header--transparent.site-header--hintergrund .site-header__shine {
    opacity: 0.25;
    animation: none;
  }

  /* Mobile band (Figma): solid dark chrome over hero */
  @media (max-width: 767.98px) {
    .site-header--transparent {
      background: var(--color-navy);
    }

    .site-header--transparent .site-header__shine {
      display: none;
    }

    .site-header--transparent.site-header--hintergrund {
      background: var(--color-cream);
      color: var(--color-ink);
    }
  }

  .site-header__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 0 0.625rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    padding-bottom: 0.15rem;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__mark {
    width: 1.05rem;
    height: 1.05rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .brand__mark span {
    background: currentColor;
    display: block;
  }

  .brand__mark span:nth-child(2),
  .brand__mark span:nth-child(3) {
    opacity: 0.35;
  }

  .brand__name {
    font-size: 1.05rem;
  }

  .site-header__desktop {
    display: none;
  }

  .site-header__desktop ul {
    display: flex;
    align-items: flex-start;
    /* Figma menue-01: 46px between Kontakt group and main cluster; ~16px among points */
    gap: clamp(1rem, 2.2vw, 2.875rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__desktop :global(a),
  .site-header__desktop :global(a:hover),
  .site-header__desktop :global(a:focus) {
    text-decoration: none !important;
  }

  @media (min-width: 768px) {
    .site-header__desktop {
      display: block;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__shine {
      transition: none;
      animation: none;
    }
  }
</style>
