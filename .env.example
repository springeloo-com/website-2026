# Public build-time env (safe to expose in the browser).
# Copy to `.env` for local builds; set the same names as GitHub Actions repository variables.

PUBLIC_SITE_URL=https://springeloo-com.github.io
PUBLIC_BASE_PATH=/website-2026/

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave empty to ship the consent banner without loading GTM.
PUBLIC_GTM_ID=
